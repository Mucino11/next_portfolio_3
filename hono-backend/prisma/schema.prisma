// prisma/schema.prisma
// Obstacle!!! I am unable to get the database to get the data from the server automatically, So inother to get latest file from the data.json, I must run the migrateData.js file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Ensure this is set to SQLite
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  status      String
  image       String?     // Optional field
  githubLink  String
  publishedAt DateTime @default(now()) // Default to current timestamp
  tags        String      // Storing tags as a comma-separated string for simplicity
  public      Boolean @default(true)
  author      String?     // Optional author field
  externalLinks ExternalLink[] // Relation to ExternalLink model
}

model ExternalLink {
  id        Int    @id @default(autoincrement())
  name      String
  url       String
  project   Project @relation(fields: [projectId], references: [id])
  projectId Int
}