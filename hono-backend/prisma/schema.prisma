// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" if you're using Postgres
  url      = env("DATABASE_URL")
}

model Project {
  id            Int       @id @default(autoincrement())
  name          String
  description   String
  status        String
  image         String?
  githubLink    String
  publishedAt   DateTime  @default(now())
  tags          String
  public        Boolean   @default(true)
  externalLinks ExternalLink[]
  author        String?
}

model ExternalLink {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId Int
}